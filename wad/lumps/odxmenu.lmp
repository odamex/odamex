      "options.weapons": {
        "header": {
          "patch": "M_WEAPON",
          "text": "WEAPONS"
        },
        "layout": {
          "style": "optionsList",
          "indent": 177
        },
        "items": [
          { "kind": "label", "text": "Weapon Preferences", "style": "heading" },
          { "kind": "cvarDiscrete", "text": "Switch on pickup", "cvar": "cl_switchweapon", "values": "WeapSwitch" },
          { "kind": "separator" },
          { "kind": "label", "text": "Weapon Switch Order", "style": "heading" },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:0", "cvar": "cl_weaponpref_fst", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:7", "cvar": "cl_weaponpref_csw", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:1", "cvar": "cl_weaponpref_pis", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:2", "cvar": "cl_weaponpref_sg", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:8", "cvar": "cl_weaponpref_ssg", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:3", "cvar": "cl_weaponpref_cg", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:4", "cvar": "cl_weaponpref_rl", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:5", "cvar": "cl_weaponpref_pls", "min": 0, "max": 8, "step": 1 },
          { "kind": "cvarSlider", "text": null, "textProvider": "weaponName:6", "cvar": "cl_weaponpref_bfg", "min": 0, "max": 8, "step": 1 },
          { "kind": "separator" },
          { "kind": "label", "text": "Weapons with higher", "style": "white" },
          { "kind": "label", "text": "preference are selected first", "style": "white" },
          { "kind": "separator" },
          { "kind": "label", "text": "! ! ! NOTICE ! ! !", "style": "heading" },
          { "kind": "label", "text": "While playing online, this feature", "style": "warning" },
          { "kind": "label", "text": "only works when the server allows it!", "style": "warning" }
        ]
      },
      "options.display": {
        "header": {
          "patch": "M_VIDEO",
          "text": "DISPLAY"
        },
        "layout": {
          "style": "optionsList",
