          { "kind": "cvarSlider", "text": "Team Color Green", "cvar": "r_teamcolor", "widget": "colorChannel", "channel": "green", "min": 0, "max": 255, "step": 17 },
          { "kind": "cvarSlider", "text": "Team Color Blue", "cvar": "r_teamcolor", "widget": "colorChannel", "channel": "blue", "min": 0, "max": 255, "step": 17 },
          { "kind": "separator" },
          { "kind": "cvarDiscrete", "text": "Force Enemy Color", "cvar": "r_forceenemycolor", "values": "OnOff" },
          { "kind": "cvarSlider", "text": "Enemy Color Red", "cvar": "r_enemycolor", "widget": "colorChannel", "channel": "red", "min": 0, "max": 255, "step": 17 },
          { "kind": "cvarSlider", "text": "Enemy Color Green", "cvar": "r_enemycolor", "widget": "colorChannel", "channel": "green", "min": 0, "max": 255, "step": 17 },
          { "kind": "cvarSlider", "text": "Enemy Color Blue", "cvar": "r_enemycolor", "widget": "colorChannel", "channel": "blue", "min": 0, "max": 255, "step": 17 },
          { "kind": "separator" },
          { "kind": "cvarSlider", "text": "UI Background Red", "cvar": "ui_transred", "min": 0, "max": 255, "step": 16 },
          { "kind": "cvarSlider", "text": "UI Background Green", "cvar": "ui_transgreen", "min": 0, "max": 255, "step": 16 },
          { "kind": "cvarSlider", "text": "UI Background Blue", "cvar": "ui_transblue", "min": 0, "max": 255, "step": 16 },
          { "kind": "cvarSlider", "text": "UI Background Visibility", "cvar": "ui_dimamount", "min": 0, "max": 1, "step": 0.1 },
          { "kind": "separator" },
          { "kind": "cvarDiscrete", "text": "See killer on Death", "cvar": "cl_deathcam", "values": "OnOff" },
          { "kind": "cvarDiscrete", "text": "Stretch short skies", "cvar": "r_stretchsky", "values": "OnOffAuto" },
          { "kind": "cvarDiscrete", "text": "Linear Skies", "cvar": "r_linearsky", "values": "OnOff" },
