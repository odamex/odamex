<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3" >
  <asmv3:application>
    <!-- Declare app as DPI aware, so that Windows Vista and later will not
       apply DPI virtualization. -->
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>true</dpiAware>
    </asmv3:windowsSettings>
    <!-- Read narrow strings - argv, the paths handed to fopen and ifstream, the
       console - as UTF-8 rather than the system ANSI code page. Without this a
       path containing any character that code page cannot represent arrives as
       a literal '?' and the open fails, so a WAD or demo under a Cyrillic or
       CJK directory is unreachable. Windows 10 1903 and later; older Windows
       ignores the setting and behaves exactly as before. -->
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">
      <activeCodePage>UTF-8</activeCodePage>
    </asmv3:windowsSettings>
    <!-- Enable newer Segment Heap instead of the older NT Heap. It improves
       memory footprint and performance. -->
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">
      <heapType>SegmentHeap</heapType>
    </asmv3:windowsSettings>
  </asmv3:application>

  <dependency>
    <dependentAssembly>
        <assemblyIdentity
            type="win32"
            name="Microsoft.Windows.Common-Controls"
            version="6.0.0.0"
            processorArchitecture="*"
            publicKeyToken="6595b64144ccf1df"
            language="*"
        />
    </dependentAssembly>
  </dependency>
</assembly>
