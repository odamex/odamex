{
    "version": 2,
    "configurePresets": [
        {
            "name": "msvc-2022",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
            }
        },
        {
            "name": "test",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build_test",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "BUILD_CLIENT": "OFF",
                "BUILD_SERVER": "OFF",
                "BUILD_LAUNCHER": "OFF",
                "BUILD_MASTER": "ON"
            }
        },
        {
            "name": "ninja",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "github-win",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "BUILD_OR_FAIL": "TRUE",
                "BUILD_CLIENT": "TRUE",
                "BUILD_SERVER": "TRUE",
                "BUILD_MASTER": "TRUE",
                "BUILD_LAUNCHER": "TRUE"
            }
        },
        {
            "name": "github-win-x32",
            "generator": "Visual Studio 17 2022",
            "architecture": "Win32",
            "binaryDir": "${sourceDir}/build-x32",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "BUILD_OR_FAIL": "TRUE",
                "BUILD_CLIENT": "TRUE",
                "BUILD_SERVER": "TRUE",
                "BUILD_MASTER": "TRUE",
                "BUILD_LAUNCHER": "TRUE"
            }
        }
    ]
}
