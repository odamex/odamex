{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

  // Note you need to run 'cmake .. -DCMAKE_BUILD_TYPE=Debug' before using these debug profiles
  // you also need the lldb vscode extension

  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Odamex Debug",
      "program": "${workspaceFolder}/build/client/odamex",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "make:client",
      "terminal": "integrated"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Odasrv Debug",
      "program": "${workspaceFolder}/build/server/odasrv",
      // you need to configure your server args!
      "args": [
        "-config",
        "/path/to/odasrv.cfg",
        "-waddir",
        "/path/to/odasrv/wads"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "make:server",
      "terminal": "external"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Odalaunch Debug",
      "program": "${workspaceFolder}/build/odalaunch/odalaunch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "make:launcher",
      "terminal": "external"
    }
  ],
  "compounds": [
    {
      "name": "Client & Server Debug",
      "configurations": ["Odasrv Debug", "Odamex Debug"]
    }
  ]
}
