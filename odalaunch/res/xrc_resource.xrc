<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxFrame" name="dlgMain">
    <style>wxDEFAULT_FRAME_STYLE|wxTAB_TRAVERSAL</style>
    <title>The Odamex Launcher</title>
    <centered>1</centered>
    <aui_managed>0</aui_managed>
    <object class="wxMenuBar" name="8">
      <object class="wxMenu" name="1">
        <label>File</label>
        <object class="wxMenuItem" name="Id_MnuItmManualConnect">
          <label>Manually connect to server...</label>
          <accel></accel>
          <help>Manually connect to a server by specifying Address:Port</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmRunOffline">
          <label>Start Odamex (Single Player)</label>
          <accel></accel>
          <help>Runs the Odamex Client without connecting to a server</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="wxID_PREFERENCES">
          <label>Settings</label>
          <accel></accel>
          <help>Configure the launcher</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="wxID_EXIT">
          <label>Exit</label>
          <accel></accel>
          <help>Exit the launcher</help>
        </object>
      </object>
      <object class="wxMenu" name="6">
        <label>Action</label>
        <object class="wxMenuItem" name="Id_MnuItmLaunch">
          <label>Connect to Selected Server</label>
          <accel></accel>
          <help>Connect to the selected server</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="Id_MnuItmRefreshServer">
          <label>Refresh Server</label>
          <accel></accel>
          <help>Refresh the selected server</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmRefreshAll">
          <label>Refresh All</label>
          <accel></accel>
          <help>Refresh all servers currently displayed</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmGetList">
          <label>Get New List</label>
          <accel></accel>
          <help>Get a new list of servers</help>
        </object>
      </object>
      <object class="wxMenu" name="2">
        <label>Tools</label>
        <object class="wxMenuItem" name="Id_MnuItmCustomServers">
          <label>Custom Servers</label>
          <accel></accel>
          <help>Set-up Custom Servers</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="Id_MnuItmOpenChat">
          <label>Open Chat</label>
          <accel></accel>
          <help>Chat with other players on Discord</help>
        </object>
      </object>
      <object class="wxMenu" name="4">
        <label>Help</label>
        <object class="wxMenuItem" name="Id_MnuItmVisitWebsite">
          <label>Website</label>
          <accel></accel>
          <help>Go to the Odamex website</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmVisitForum">
          <label>Forum</label>
          <accel></accel>
          <help>Visit the Odamex forum</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmVisitWiki">
          <label>Wiki</label>
          <accel></accel>
          <help>Visit the Odamex Wiki</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="Id_MnuItmViewChangelog">
          <label>Changelog</label>
          <accel></accel>
          <help>Open the Changelog</help>
        </object>
        <object class="wxMenuItem" name="Id_MnuItmSubmitBugReport">
          <label>Report Bug</label>
          <accel></accel>
          <help>Report a bug</help>
        </object>
        <object class="separator"/>
        <object class="wxMenuItem" name="Id_MnuItmCheckVersion">
          <label>Check For Updates</label>
          <accel></accel>
          <help>Check for any new versions of Odamex</help>
        </object>
        <object class="wxMenuItem" name="wxID_ABOUT">
          <label>About</label>
          <accel></accel>
          <help>About the Odamex Launcher</help>
        </object>
      </object>
    </object>
    <object class="wxToolBar" name="61">
      <font>
        <style>normal</style>
        <weight>normal</weight>
        <family>default</family>
        <underlined>0</underlined>
      </font>
      <bitmapsize>32,32</bitmapsize>
      <margins>-1,-1</margins>
      <packing>0</packing>
      <separation>0</separation>
      <object class="tool" name="Id_MnuItmLaunch">
        <label>Connect</label>
        <tooltip>Connect to the selected server</tooltip>
        <longhelp>Connect to the selected server</longhelp>
        <bitmap>./icons/btnlaunch.png</bitmap>
      </object>
      <object class="tool" name="Id_MnuItmRunOffline">
        <label>Run Odamex</label>
        <tooltip>Runs the Odamex Client without connecting to a server</tooltip>
        <longhelp>Runs the Odamex Client without connecting to a server</longhelp>
        <bitmap>./icons/btnqlaunch.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="Id_MnuItmRefreshServer">
        <label>Refresh Server</label>
        <tooltip>Refresh the selected server</tooltip>
        <longhelp>Refresh the selected server</longhelp>
        <bitmap>./icons/btnrefresh.png</bitmap>
      </object>
      <object class="tool" name="Id_MnuItmRefreshAll">
        <label>Refresh All</label>
        <tooltip>Refresh all servers currently displayed</tooltip>
        <longhelp>Refresh all servers currently displayed</longhelp>
        <bitmap>./icons/btnrefresha.png</bitmap>
      </object>
      <object class="tool" name="Id_MnuItmGetList">
        <label>Get List</label>
        <tooltip>Get a new list of servers</tooltip>
        <longhelp>Get a new list of servers</longhelp>
        <bitmap>./icons/btngetlist.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="Id_MnuItmOpenChat">
        <label>tool</label>
        <tooltip>Chat with other players on Discord</tooltip>
        <longhelp>Chat with other players on Discord</longhelp>
        <bitmap>./icons/btnchat.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="wxID_PREFERENCES">
        <label>Settings</label>
        <tooltip>Configure the launcher</tooltip>
        <longhelp>Configure the launcher</longhelp>
        <bitmap>./icons/btnprefs.png</bitmap>
      </object>
      <object class="tool" name="wxID_ABOUT">
        <label>About</label>
        <tooltip>About the Odamex Launcher</tooltip>
        <longhelp>About the Odamex Launcher</longhelp>
        <bitmap>./icons/btnabout.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="tool" name="wxID_EXIT">
        <label>Exit</label>
        <tooltip>Exit the launcher</tooltip>
        <longhelp>Exit the launcher</longhelp>
        <bitmap>./icons/btnexit.png</bitmap>
      </object>
      <object class="separator"/>
      <object class="wxSearchCtrl" name="Id_SrchCtrlGlobal">
        <size>175,-1</size>
        <value></value>
      </object>
    </object>
